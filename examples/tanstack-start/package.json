{
  "name": "prisma-fixtures-tanstack-start-example",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "db:generate": "prisma contract emit && prisma-fixtures-generator src/generated/prisma/contract.json src/generated/prisma-fixtures",
    "db:push": "prisma db init",
    "db:seed": "prisma-fixtures",
    "db:reset": "prisma-fixtures --reset",
    "lint:fixtures": "npm run db:generate && prisma-fixtures ./prisma/fixtures --lint --schema src/generated/prisma-fixtures/schema.json"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.12",
    "@tanstack/react-start": "1.168.58",
    "@tanstack/react-router": "1.170.39",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@skmdev/prisma-fixtures": "1.0.0-rc.1",
    "argon2": "0.45.1",
    "prisma": "8.0.0-rc.17",
    "@types/node": "22.19.15",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
