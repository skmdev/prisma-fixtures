{
  "name": "prisma-fixtures-sveltekit-example",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "db:generate": "prisma contract emit && prisma-fixtures-generator src/generated/prisma/contract.json src/generated/prisma-fixtures",
    "db:push": "prisma db init",
    "db:seed": "prisma-fixtures",
    "db:reset": "prisma-fixtures --reset",
    "lint:fixtures": "npm run db:generate && prisma-fixtures ./prisma/fixtures --lint --schema src/generated/prisma-fixtures/schema.json"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.12",
    "@sveltejs/kit": "2.70.3",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@skmdev/prisma-fixtures": "0.1.1",
    "argon2": "0.45.1",
    "prisma": "8.0.0-rc.17",
    "@types/node": "22.19.15",
    "typescript": "5.9.3",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "vite": "8.3.1"
  }
}
